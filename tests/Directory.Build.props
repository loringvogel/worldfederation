<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
  <PropertyGroup>
    <!-- Test projects use underscore naming conventions by convention; suppress CA1707 -->
    <NoWarn>$(NoWarn);CA1707;CA1307;CA2007</NoWarn>
  </PropertyGroup>
</Project>
