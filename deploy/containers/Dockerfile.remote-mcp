# syntax=docker/dockerfile:1

# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY AgentFederation.sln Directory.Build.props global.json ./
COPY src/Federation.Protocol/Federation.Protocol.csproj             src/Federation.Protocol/
COPY src/Federation.Cryptography/Federation.Cryptography.csproj     src/Federation.Cryptography/
COPY src/Federation.Identity/Federation.Identity.csproj             src/Federation.Identity/
COPY src/Federation.Sync/Federation.Sync.csproj                     src/Federation.Sync/
COPY src/Federation.Transport/Federation.Transport.csproj           src/Federation.Transport/
COPY src/Federation.Node/Federation.Node.csproj                     src/Federation.Node/
COPY src/Federation.Node.ToolServer/Federation.Node.ToolServer.csproj src/Federation.Node.ToolServer/
COPY src/Federation.Node.RemoteMcp/Federation.Node.RemoteMcp.csproj src/Federation.Node.RemoteMcp/

RUN dotnet restore src/Federation.Node.RemoteMcp/Federation.Node.RemoteMcp.csproj

COPY src/ src/
RUN dotnet publish src/Federation.Node.RemoteMcp/Federation.Node.RemoteMcp.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final

RUN addgroup --system federation && adduser --system --ingroup federation federation
WORKDIR /app

COPY --from=build /app/publish .

USER federation

ENV ASPNETCORE_URLS=http://+:5002
EXPOSE 5002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:5002/health || exit 1

ENTRYPOINT ["dotnet", "federation-remote-mcp.dll"]
