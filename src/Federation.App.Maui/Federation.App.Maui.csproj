<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0-windows10.0.19041.0;net9.0-maccatalyst</TargetFrameworks>
    <RootNamespace>Federation.App.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- Application metadata -->
    <ApplicationTitle>Agent Federation</ApplicationTitle>
    <ApplicationId>com.worldfederation.node</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <!-- Produce a plain EXE on Windows; no MSIX packaging needed -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Mac Catalyst minimum OS -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <!-- Entitlements for FolderPicker + outbound networking -->
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    <!-- Windows minimum OS -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- CA1056: URL-like properties as string — config/options records kept as string.
         CA1031: broad catch — intentional for first-run file load and relay connectivity checks.
         CA2007: ConfigureAwait — MAUI UI event handlers must stay on the UI thread.
         CA1812: internal DTO classes instantiated by JSON deserializer via reflection.
         CA5392: P/Invoke in Windows App SDK file we do not own. -->
    <NoWarn>$(NoWarn);CA1056;CA1031;CA2007;CA1812;CA5392</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.*" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Federation.Node\Federation.Node.csproj" />
    <ProjectReference Include="..\..\src\Federation.AgentGateway\Federation.AgentGateway.csproj" />
    <ProjectReference Include="..\..\src\Federation.AgentAdapters.OpenAI\Federation.AgentAdapters.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\Federation.Node.ToolServer\Federation.Node.ToolServer.csproj" />
  </ItemGroup>
</Project>
