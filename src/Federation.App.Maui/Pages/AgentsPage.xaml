<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Federation.App.Maui.Pages.AgentsPage"
             Title="Agents">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <!-- Status banner -->
            <Border x:Name="StatusBanner" IsVisible="False"
                    StrokeShape="RoundRectangle 8" Padding="12,10" Margin="0,0,0,14">
                <Label x:Name="StatusLabel" FontSize="13" />
            </Border>

            <!-- ── Generate Invite Token ── -->
            <Label Text="INVITE NEW AGENT" FontSize="11" FontAttributes="Bold" TextColor="Gray" Margin="0,0,0,4" />
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1c1c1e}"
                    Padding="16,14" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Room" FontSize="12" TextColor="Gray" />
                    <Picker x:Name="InviteRoomPicker" Title="— select room —" />
                    <Label Text="Role" FontSize="12" TextColor="Gray" />
                    <Picker x:Name="InviteRolePicker" Title="— select role —">
                        <Picker.Items>
                            <x:String>Participant</x:String>
                            <x:String>Observer</x:String>
                            <x:String>Owner</x:String>
                        </Picker.Items>
                    </Picker>
                    <Label Text="Max uses (0 = unlimited)" FontSize="12" TextColor="Gray" />
                    <Entry x:Name="MaxUsesEntry" Text="1" Keyboard="Numeric" FontSize="14" />
                    <Button Text="Generate Invite Token" Clicked="OnGenerateInviteTokenAsync"
                            BackgroundColor="#0a84ff" TextColor="White"
                            CornerRadius="8" FontSize="14" HeightRequest="40" />

                    <!-- Result box, hidden until token generated -->
                    <Border x:Name="TokenResultBox" IsVisible="False"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{AppThemeBinding Light=#f2f2f7, Dark=#2c2c2e}"
                            Padding="12,10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Share this command:" FontSize="12" TextColor="Gray" />
                            <Label x:Name="TokenCommandLabel" FontSize="12" FontFamily="Monospace" />
                            <Button Text="Copy" Clicked="OnCopyTokenCommand"
                                    BackgroundColor="{AppThemeBinding Light=#e5e5ea, Dark=#3a3a3c}"
                                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                    CornerRadius="8" FontSize="13" HeightRequest="32" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- ── Registered Agents ── -->
            <Label Text="REGISTERED AGENTS" FontSize="11" FontAttributes="Bold" TextColor="Gray" Margin="0,0,0,4" />
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1c1c1e}"
                    Padding="16,14" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="0">
                    <Button Text="Refresh" Clicked="OnRefreshAsync"
                            BackgroundColor="{AppThemeBinding Light=#e5e5ea, Dark=#3a3a3c}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            CornerRadius="8" FontSize="13" HeightRequest="36" Margin="0,0,0,10" />
                    <CollectionView x:Name="AgentsCollection" EmptyView="No agents registered yet.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light=#f2f2f7, Dark=#2c2c2e}"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="{Binding DeviceId}" FontSize="11" FontFamily="Monospace" TextColor="Gray" />
                                        <Label Text="{Binding RegisteredAt, StringFormat='Registered {0:MMM d, yyyy}'}"
                                               FontSize="11" TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ── Active Invite Tokens ── -->
            <Label Text="ACTIVE INVITE TOKENS" FontSize="11" FontAttributes="Bold" TextColor="Gray" Margin="0,0,0,4" />
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1c1c1e}"
                    Padding="16,14" Margin="0,0,0,12">
                <VerticalStackLayout Spacing="0">
                    <CollectionView x:Name="TokensCollection" EmptyView="No active invite tokens.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{AppThemeBinding Light=#f2f2f7, Dark=#2c2c2e}"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding TokenCode}" FontSize="13" FontFamily="Monospace" FontAttributes="Bold" />
                                            <Label Text="{Binding UsageSummary}" FontSize="11" TextColor="Gray" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
