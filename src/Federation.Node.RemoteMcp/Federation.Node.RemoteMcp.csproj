<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>federation-remote-mcp</AssemblyName>
    <RootNamespace>Federation.Node.RemoteMcp</RootNamespace>
    <!-- Suppress same categories as the stdio MCP server -->
    <NoWarn>$(NoWarn);CA1303;CA1056;CA1062;CA2227;CA1869;CA2000;CA1001;CA2234;CA1707;CA1031;CA1812;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Remote HTTP/SSE MCP transport (v2.x — separate package from the stdio v0.2 server) -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Federation.Node\Federation.Node.csproj" />
    <ProjectReference Include="..\Federation.Node.ToolServer\Federation.Node.ToolServer.csproj" />
    <ProjectReference Include="..\Federation.Cryptography\Federation.Cryptography.csproj" />
    <ProjectReference Include="..\Federation.Protocol\Federation.Protocol.csproj" />
  </ItemGroup>
</Project>
