<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Federation.Cli</RootNamespace>
    <AssemblyName>federation</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CLI tool: suppress localization (CA1303), URI-as-string (CA1056), null-check externals (CA1062),
         collection setters needed for JSON deserialization (CA2227), cached JsonSerializerOptions (CA1869),
         toLower in display strings (CA1308), Dispose pattern for simple wrappers (CA2000, CA1001),
         enum flag display (CA1305) -->
    <NoWarn>$(NoWarn);CA1303;CA1056;CA1062;CA2227;CA1869;CA1308;CA2000;CA1001;CA1305;CA2234</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Federation.Node\Federation.Node.csproj" />
    <ProjectReference Include="..\..\src\Federation.Node.ToolServer\Federation.Node.ToolServer.csproj" />
    <ProjectReference Include="..\..\src\Federation.AgentGateway\Federation.AgentGateway.csproj" />
    <ProjectReference Include="..\..\src\Federation.Cryptography\Federation.Cryptography.csproj" />
    <ProjectReference Include="..\..\src\Federation.Protocol\Federation.Protocol.csproj" />
  </ItemGroup>
</Project>
